{
  "name": "polaris-microgrid-suite",
  "version": "1.0.0",
  "private": true,
  "description": "POLARIS: Polar Microgrid Telemetry, AI Forecasting & Autonomous Dispatch Optimization Suite",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
